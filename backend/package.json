{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "node --watch -r ts-node/register/transpile-only src/app.ts",
    "migration:generate": "typeorm-ts-node-commonjs -d ./src/utils/db.ts migration:generate ./src/migrations/default",
    "migration:run": "typeorm-ts-node-commonjs -d ./src/utils/db.ts migration:run",
    "migration:run:prod": "typeorm -d ./dist/utils/db.js migration:run",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --runInBand"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "overrides": {
    "form-data": "^4.0.6",
    "brace-expansion": "^5.0.12",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "axios": "^1.13.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28"
  }
}