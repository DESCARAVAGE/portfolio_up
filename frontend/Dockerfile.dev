# Image de développement : serveur Next avec rechargement à chaud, port 5173
# (le même que l'ancien frontend Vite, pour ne rien changer à docker-compose.yml).

FROM node:24-alpine

WORKDIR /app

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NEXT_TELEMETRY_DISABLED=1

# Seule étape qui demande root : installer le lanceur pnpm
RUN corepack enable && chown node:node /app

# Tout le reste tourne avec l'utilisateur "node" de l'image (uid 1000), jamais root
USER node

COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts

# Uniquement ce qu'il faut pour lancer le site (pas de copie globale :
# aucun fichier local ou secret ne peut se retrouver dans l'image par erreur)
COPY --chown=node:node next.config.ts tsconfig.json postcss.config.mjs ./
COPY --chown=node:node app ./app
COPY --chown=node:node public ./public

# Créé ici pour que le volume /app/.next de docker-compose.yml appartienne à "node"
RUN mkdir .next

EXPOSE 5173

CMD ["pnpm", "dev", "--hostname", "0.0.0.0", "--port", "5173"]